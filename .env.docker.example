# Copy this file to .env.docker and fill in your real values.
# DATABASE_URL and REDIS_URL are injected automatically by docker-compose.yml,
# so you do NOT need to set them here.

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Elaris"

# AI (leave blank to use deterministic mode)
AI_PROVIDER="deterministic"
AI_PROVIDER_API_KEY=""
AI_MODEL_CHAT=""
AI_MODEL_CLASSIFIER=""

# Storage — Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email — Brevo (leave blank to log OTPs to terminal)
EMAIL_PROVIDER="brevo"
EMAIL_FROM="Elaris <your@email.com>"
BREVO_API_KEY=""

# Payments
PAYMENT_COD_ENABLED="true"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
CARD_PROVIDER_API_KEY=""

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Admin
ADMIN_2FA_REQUIRED="false"
ADMIN_PASSWORD="change-me-in-production"

# Store config
STORE_CURRENCY="BDT"
STORE_LOCALE="en-BD"
ORDER_PREFIX="ORD"
